# flask (required)
SECRET_KEY=change-me

# database (required)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vault_local
DB_USER=your_postgres_username
DB_PASSWORD=

# optional: database encryption. leave blank locally, use "require" for AWS RDS.
DB_SSLMODE=

# optional: AWS S3 image storage. leave blank to save images locally in static/uploads/
AWS_S3_BUCKET=
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# required for checkout
STRIPE_SECRET_KEY=
